		"name": "Contentful Products Report API",
		"description": "Complete API collection for managing products from Contentful and generating reports. Uses JWT authentication with automatic token management.",
		"schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json",
		"_exporter_id": "4921348",
		"_collection_link": "https://septum-crm.postman.co/workspace/Septum---CRM-Workspace~e4f1a7f1-9bfe-4c9a-8041-0de3753b1780/collection/4921348-5944bfab-3392-41a6-90f5-04f2d42ee325?action=share&source=collection_link&creator=4921348"
	},
	"item": [
		{
			"name": "Auth",
			"description": "Authentication endpoints for generating JWT tokens",
			"item": [
				{
					"name": "Generate JWT Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Automatically save the JWT token to environment variable",
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.environment.set(\"token\", jsonData.access_token);",
									"    console.log(\"✅ JWT token saved to environment:\", jsonData.access_token);",
									"} else {",
									"    console.log(\"❌ No token received\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"apiKey\": \"{{api_key}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{base_url}}/auth/token",
						"description": "Generate a JWT token using the API Key. The token is automatically saved to the environment variable 'token' and will be used for protected endpoints."
					},
					"response": []
				}
			]
		},
		{
			"name": "Health",
