			"description": "Product management endpoints - CRUD operations and synchronization",
			"item": [
				{
					"name": "List All Products (with filters)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/products?page=1&limit=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"products"
							],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number (default: 1)"
								},
								{
									"key": "limit",
									"value": "10",
									"description": "Items per page (default: 5)"
								},
								{
									"key": "name",
									"value": "Nike",
									"description": "Filter by product name",
									"disabled": true
								},
								{
									"key": "brand",
									"value": "Nike",
									"description": "Filter by brand",
									"disabled": true
								},
								{
									"key": "category",
									"value": "Footwear",
									"description": "Filter by category",
									"disabled": true
								},
								{
									"key": "color",
									"value": "Black",
									"description": "Filter by color",
									"disabled": true
								},
								{
									"key": "minPrice",
									"value": "50",
									"description": "Minimum price",
									"disabled": true
								},
								{
									"key": "maxPrice",
									"value": "200",
									"description": "Maximum price",
									"disabled": true
								},
								{
									"key": "sku",
									"value": "12345",
									"description": "Filter by SKU",
									"disabled": true
								}
							]
						},
						"description": "Get paginated list of products with optional filters: name, brand, category, color, price range, and SKU."
					},
					"response": []
				},
				{
					"name": "Get Product by ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": {
								"token": "{{token}}"
							}
						},
						"method": "GET",
						"header": [],
						"url": "{{base_url}}/products/{{product_id}}",
						"description": "Get a specific product by its MongoDB ID. Requires JWT authentication."
					},
					"response": []
				},
				{
					"name": "Soft Delete Product",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "DELETE",
						"header": [],
						"url": "{{base_url}}/products/{{product_id}}",
						"description": "Soft delete a product (marks as deleted but preserves data). Does not require authentication."
					},
					"response": []
				},
				{
					"name": "Sync Products from Contentful",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": {
								"token": "{{token}}"
							}
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{base_url}}/products/sync",
						"description": "Manually trigger synchronization of products from Contentful CMS. Requires JWT authentication."
					},
					"response": []
				},
				{
					"name": "Truncate All Products (⚠️ DANGER)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": {
								"token": "{{token}}"
							}
						},
						"method": "DELETE",
						"header": [],
						"url": "{{base_url}}/products/truncate",
						"description": "⚠️ DANGER: Delete ALL products from the database. This action cannot be undone. Requires JWT authentication."
					},
					"response": []
				}
			]
		},
